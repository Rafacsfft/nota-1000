# Endereço público final do site
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_SUPPORT_EMAIL=contato@nota1000.com.br

# Firebase Web App (dados públicos fornecidos pelo Firebase Console)
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# Backend. Em produção, OPENAI_API_KEY deve ser um secret do Firebase.
FIREBASE_PROJECT_ID=
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.6-luna
MONTHLY_CORRECTION_LIMIT=5
STORE_ESSAY_TEXT=false
